  <collaboration id="Collaboration_2">
    <participant id="Pool_SesionEntrevista" name="Sesión de Entrevista" processRef="Process_SesionEntrevista" />
    <participant id="Pool_Ingeniero" name="Ingeniero de Software" processRef="Process_Ingeniero" />
    <participant id="Pool_Algoritmos" name="- Sistema -&#10;Procesamiento" processRef="Process_Algoritmos" />
    <messageFlow id="Flow_0vkvq6d" name="Resultados" sourceRef="Task_Resultados" targetRef="Activity_0tbpjeb" />
