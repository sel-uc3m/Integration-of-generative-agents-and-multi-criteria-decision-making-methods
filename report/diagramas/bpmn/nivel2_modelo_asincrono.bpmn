    <dataObject id="DataObject_0x2yrny" />
    <endEvent id="End_S" name="Fin sesión entrevista">
      <incoming>Flow_06unknn</incoming>
    </endEvent>
    <task id="Activity_0tbpjeb" name="Observar resultados">
      <incoming>sf_persiste_to_observa</incoming>
      <outgoing>Flow_06unknn</outgoing>
    </task>
    <task id="Task_Persiste" name="Persistir resultado&#10;en ficheros">
      <incoming>sf_loop_no</incoming>
      <outgoing>sf_persiste_to_observa</outgoing>
      <dataOutputAssociation id="DataOutputAssociation_101tgwf">
        <targetRef>DataObjectReference_1dcowlj</targetRef>
      </dataOutputAssociation>
      <dataOutputAssociation id="DataOutputAssociation_1l00fw6">
        <targetRef>DataObjectReference_0a28n3n</targetRef>
      </dataOutputAssociation>
    </task>
    <task id="Task_Responde" name="Responder preguntas&#10;de la entrevista">
      <incoming>sf_agent_to_responde</incoming>
      <outgoing>sf_responde_to_gateway</outgoing>
    </task>
    <task id="Task_Entrevista" name="Conducir entrevista&#10;(preguntas y aclaraciones)">
      <incoming>sf_s_to_agent</incoming>
      <incoming>sf_loop_yes</incoming>
      <outgoing>sf_agent_to_responde</outgoing>
    </task>
    <exclusiveGateway id="Gateway_Loop" name="¿Quedan preguntas?">
      <incoming>sf_responde_to_gateway</incoming>
      <outgoing>sf_loop_yes</outgoing>
      <outgoing>sf_loop_no</outgoing>
    </exclusiveGateway>
    <task id="Task_IniciarSesion" name="Iniciar sesión&#10;de entrevista">
      <incoming>sf_s1</incoming>
      <outgoing>sf_s_to_agent</outgoing>
    </task>
    <startEvent id="Start_S" name="Inicio entrevista" />
    <sequenceFlow id="Flow_06unknn" sourceRef="Activity_0tbpjeb" targetRef="End_S" />
    <sequenceFlow id="sf_persiste_to_observa" sourceRef="Task_Persiste" targetRef="Activity_0tbpjeb" />
    <sequenceFlow id="sf_loop_no" name="No" sourceRef="Gateway_Loop" targetRef="Task_Persiste" />
    <sequenceFlow id="sf_agent_to_responde" sourceRef="Task_Entrevista" targetRef="Task_Responde" />
    <sequenceFlow id="sf_responde_to_gateway" sourceRef="Task_Responde" targetRef="Gateway_Loop" />
    <sequenceFlow id="sf_s_to_agent" sourceRef="Task_IniciarSesion" targetRef="Task_Entrevista" />
    <sequenceFlow id="sf_loop_yes" name="Sí" sourceRef="Gateway_Loop" targetRef="Task_Entrevista" />
    <sequenceFlow id="sf_s1" sourceRef="Start_S" targetRef="Task_IniciarSesion" />
  </process>
