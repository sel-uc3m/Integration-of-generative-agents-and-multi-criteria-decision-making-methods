  <process id="Process_SesionEntrevista" isExecutable="false">
    <laneSet id="LaneSet_Sesion">
      <lane id="Lane_AgenteIA" name="- Sistema -&#10; Recolección">
        <flowNodeRef>Task_Persiste</flowNodeRef>
        <flowNodeRef>Task_Entrevista</flowNodeRef>
        <flowNodeRef>Gateway_Loop</flowNodeRef>
      </lane>
      <lane id="Lane_Stakeholder" name="Stakeholder">
        <flowNodeRef>End_S</flowNodeRef>
        <flowNodeRef>Activity_0tbpjeb</flowNodeRef>
        <flowNodeRef>Task_Responde</flowNodeRef>
        <flowNodeRef>Task_IniciarSesion</flowNodeRef>
        <flowNodeRef>Start_S</flowNodeRef>
      </lane>
