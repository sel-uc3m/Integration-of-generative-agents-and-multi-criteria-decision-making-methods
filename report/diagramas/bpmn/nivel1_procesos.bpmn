<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="nivel1_procesos" targetNamespace="http://tfm.adrian/nivel1" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.27.0">
  <collaboration id="Collaboration_1">
    <participant id="Pool_Stakeholder" name="Stakeholder" processRef="Process_Stakeholder" />
    <participant id="Pool_Sistema" name="Sistema de Soporte" processRef="Process_Sistema" />
    <participant id="Pool_Salida" name="Stakeholder" processRef="Process_Salida" />
    <messageFlow id="mf1" name="Información de la empresa" sourceRef="Task_InfoEmpresa" targetRef="Task_ALTUS" />
    <messageFlow id="mf2" name="Procesos actuales y objetivos" sourceRef="Task_InfoProcesos" targetRef="Task_SIPAC" />
    <messageFlow id="mf3" name="Criterios de priorización" sourceRef="Task_Criterios" targetRef="Task_AHP" />
    <messageFlow id="mf4" name="Resultado ALTUS" sourceRef="Task_ALTUS" targetRef="Task_RecibeALTUS" />
    <messageFlow id="mf6" name="Artefactos propuestos" sourceRef="Task_SIPAC" targetRef="Task_RecibeSIPAC" />
    <messageFlow id="mf5" name="Resultado AHP&#10;(Roadmap priorizado)" sourceRef="Task_AHP" targetRef="Task_RecibeAHP" />
  </collaboration>
  <process id="Process_Stakeholder" isExecutable="false">
    <startEvent id="Start_S" name="Inicio" />
    <task id="Task_InfoEmpresa" name="Proveer información&#10;de la empresa" />
    <task id="Task_InfoProcesos" name="Proveer procesos actuales&#10;y objetivos" />
    <task id="Task_Criterios" name="Proveer criterios&#10;de priorización" />
    <endEvent id="End_S" name="Fin" />
    <sequenceFlow id="sf_s1" sourceRef="Start_S" targetRef="Task_InfoEmpresa" />
    <sequenceFlow id="sf_s2" sourceRef="Task_InfoEmpresa" targetRef="Task_InfoProcesos" />
    <sequenceFlow id="sf_s3" sourceRef="Task_InfoProcesos" targetRef="Task_Criterios" />
    <sequenceFlow id="sf_s4" sourceRef="Task_Criterios" targetRef="End_S" />
  </process>
  <process id="Process_Sistema" isExecutable="false">
    <task id="Task_ALTUS" name="ALTUS&#10;Madurez Digital" />
    <task id="Task_SIPAC" name="SIPAC&#10;Activos y Artefactos" />
    <task id="Task_AHP" name="AHP&#10;Priorización" />
    <sequenceFlow id="sf_sys1" sourceRef="Task_SIPAC" targetRef="Task_AHP" />
  </process>
  <process id="Process_Salida" isExecutable="false">
    <task id="Task_RecibeALTUS" name="Recibir Resultado ALTUS" />
    <task id="Task_RecibeSIPAC" name="Recibir Artefactos&#10;propuestos" />
    <task id="Task_RecibeAHP" name="Recibir Roadmap&#10;priorizado" />
    <endEvent id="End_Sal" name="Fin" />
    <sequenceFlow id="sf_sal1" sourceRef="Task_RecibeALTUS" targetRef="End_Sal" />
    <sequenceFlow id="sf_sal3" sourceRef="Task_RecibeSIPAC" targetRef="End_Sal" />
    <sequenceFlow id="sf_sal2" sourceRef="Task_RecibeAHP" targetRef="End_Sal" />
  </process>
