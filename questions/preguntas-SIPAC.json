                              "type": "string"
                            },
                            "importancia_activo": {
                              "type": "number"
                            },
                            "intellectus_ci": {
                              "type": "string"
                            },
                            "artefactos_propuestos": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
