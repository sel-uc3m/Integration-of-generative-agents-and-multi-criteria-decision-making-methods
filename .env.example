# ==============================================================================
# Configuración del Entorno de Despliegue (VPS con Ollama)
# ==============================================================================

# URL base del servicio Ollama local en el VPS
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Modelo predeterminado descargado en Ollama (ej. deepseek-r1:7b, qwen2.5:7b, llama3.3:70b)
EVAL_MODEL=deepseek-r1:7b

# Puerto de la aplicación web
PORT=3000
NODE_ENV=production
