{
  "name": "@tfm/core",
  "version": "1.0.0",
  "description": "Metodología para la integración de agentes generativos en la toma de decisiones en la fase de preproyecto",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "dev:hybrid": "EVAL_HYBRID=true tsx src/index.ts",
    "lint": "eslint . --ext .ts",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:llm": "RUN_LLM_TESTS=1 vitest run --config vitest.llm.config.ts",
    "eval": "tsx eval/runner.ts",
    "eval:matrix": "tsx eval/runner.ts --models=deepseek-r1:7b,ornith:9b,gemma4:12b-mlx,gemma4:e4b-mlx,qwen3.5:4b-mlx",
    "eval:calibrate": "tsx eval/calibrate_threshold.ts",
    "eval:restore-cache": "python3 ../tools/restore_full_eval_cache.py",
    "eval:rescore": "tsx eval/recalculate.ts",
    "eval:baseline": "tsx eval/run_baseline.ts"
  },
  "devDependencies": {
    "@types/node": "^25.2.0",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@arizeai/openinference-instrumentation-langchain": "^4.0.14",
    "@langchain/core": "^1.1.19",
    "@langchain/google-genai": "^2.1.31",
    "@langchain/langgraph": "^1.1.3",
    "@langchain/ollama": "^1.2.2",
    "@langchain/openai": "^1.4.7",
    "dotenv": "^17.4.2",
    "zod": "^4.3.6"
  }
}
